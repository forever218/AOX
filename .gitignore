# ══════════════════════════════════════════════════════════
#  AOX — 忽略规则
# ══════════════════════════════════════════════════════════

# ── 构建产物（本机 target 约 3.5 GB）──────────────────────
/target/

# ── 发行产物：Windows 安装包 ──────────────────────────────
/dist/

# ── 本地配置：可能含真实 API key ──────────────────────────
# 注意：下面的通配会连 config.example.toml 一起吃掉，
# 所以必须补一条显式否定，把模板放回版本库。
config.toml
config.*.toml
!/config.example.toml
# GUI 联调配置（指向本机 mock 端点，不含真实凭证）
/gui/test-config*.toml

# ── 运行期数据 ────────────────────────────────────────────
/logs/
/plugins/*
!/plugins/.gitkeep
/history/
# AOX 自己的每工作区数据：对话历史、草稿、笔记。
# 2026-10-14 起历史移进 <工作区>/.aox/history（默认工作区就是本项目根），
# 不忽略这里会把整份对话历史塞进 git。旧的 /history/ 已废弃，留着只为旧检出。
.aox/
**/stderr.log

# 按需装配的插件运行时（约 21 MB，机器相关；由 /runtime install python
# 或 tools/build_installer.sh 的 ensure_runtime 生成，可随时重建）
/runtime/

# ── 本机工具链配置 ────────────────────────────────────────
# .cargo/config.toml 里硬编码了本机 VS2022（14.44.35207）与 Win SDK
# （10.0.26100.0）的绝对路径，提交后会让别的机器 clone 下来直接构建失败。
# 需要的人按 README「Windows 构建」一节自建即可。
.cargo/config.toml

# ── 开发期临时产物 ────────────────────────────────────────
# GUI 验证截图与截图脚本的输出日志（体积大且可随时重生成）
/gui/*.png
/gui/*.txt
# GUI 联调用的空插件目录（宿主启动时会自行写入 sdk）
/gui/test-plugins/
__pycache__/
*.pyc

# ── 本机会话数据与开发笔记 ────────────────────────────────
.workbuddy/
# GUI 记住的明暗偏好（本机偏好，不入库）
.aox-gui-theme


# ── 其他不入库的本机文件 ────────────────────────────────
/workplace/